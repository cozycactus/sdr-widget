#!/bin/sh
##
## This makes the widget with avr32-gcc from PATH. Set AVR32BIN to prepend a
## specific toolchain directory.
##
if [ -n "$AVR32BIN" ]; then
	PATH=$AVR32BIN:$PATH
	export PATH
fi

if ! command -v avr32-gcc >/dev/null 2>&1; then
	echo "avr32-gcc not found; set AVR32BIN or add avr32-gcc to PATH" >&2
	exit 127
fi

cd Release && make all
